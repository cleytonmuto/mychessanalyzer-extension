{
  "manifest_version": 3,
  "name": "mychessanalyzer",
  "version": "1.1.0",
  "description": "Plays Duolingo chess and chess.com computer games with the local mychessanalyzer Stockfish API.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.duolingo.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.duolingo.com/chess*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.chess.com/play/computer*"],
      "js": ["chesscom.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-hook.js"],
      "matches": ["https://www.duolingo.com/*"]
    }
  ]
}
